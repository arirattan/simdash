{
  "_README": [
    "Maps SimHub property names -> dashboard keys. The bridge reloads this file automatically when you save it.",
    "Each key lists candidate SimHub properties in 'props'; the FIRST one that has a value is used.",
    "To find the exact names on your install: SimHub > Available properties > type e.g. 'altitude' > right-click > Copy name, then paste it at the TOP of the 'props' list.",
    "Open the dashboard's  ⚙ > Property inspector  on the iPad to see which keys are resolved and which are still empty.",
    "Options per key: scale, offset, invert (true/false), rad2deg (true/false), type ('number' | 'bool' | 'string').",
    "Names under DataCorePlugin.GameData.* are SimHub's generic ones. Names under GameRawData.* are GUESSES - verify them in SimHub."
  ],
  "_default_profile": "msfs",

  "msfs": {
    "_match": ["FlightSimulator", "MSFS", "FS2024", "FS2020", "Microsoft"],

    "pitch":   { "unit": "deg", "props": ["DataCorePlugin.GameRawData.PlanePitchDegrees", "DataCorePlugin.GameData.OrientationPitch"], "invert": false },
    "roll":    { "unit": "deg", "props": ["DataCorePlugin.GameRawData.PlaneBankDegrees", "DataCorePlugin.GameData.OrientationRoll"], "invert": false },
    "heading": { "unit": "deg", "props": ["DataCorePlugin.GameRawData.PlaneHeadingDegreesMagnetic", "DataCorePlugin.GameRawData.HeadingIndicator", "DataCorePlugin.GameData.OrientationYaw"] },
    "ias":     { "unit": "kt",  "props": ["DataCorePlugin.GameRawData.AirspeedIndicated", "DataCorePlugin.GameData.SpeedKmh"], "_note": "if you end up on SpeedKmh, add \"scale\": 0.539957" },
    "alt":     { "unit": "ft",  "props": ["DataCorePlugin.GameRawData.IndicatedAltitude", "DataCorePlugin.GameRawData.PlaneAltitude"] },
    "vs":      { "unit": "fpm", "props": ["DataCorePlugin.GameRawData.VerticalSpeed"], "scale": 60, "_note": "SimConnect VERTICAL SPEED is ft/s -> x60. Remove scale if SimHub already gives ft/min." },
    "turn":    { "unit": "deg", "props": ["DataCorePlugin.GameRawData.TurnIndicatorRate"], "rad2deg": true, "scale": 6.67, "_note": "standard-rate (3 deg/s) -> ~20 deg wing tilt" },
    "slip":    { "unit": "-1..1", "props": ["DataCorePlugin.GameRawData.TurnCoordinatorBall"], "scale": 0.0079 },
    "baro":    { "unit": "hPa", "props": ["DataCorePlugin.GameRawData.KohlsmanSettingMb"] },
    "mach":    { "unit": "M",   "props": ["DataCorePlugin.GameRawData.AirspeedMach"] },
    "g":       { "unit": "G",   "props": ["DataCorePlugin.GameRawData.GForce", "DataCorePlugin.GameData.AccelerationHeave"] },
    "aoa":     { "unit": "deg", "props": ["DataCorePlugin.GameRawData.IncidenceAlpha"], "rad2deg": true },
    "radalt":  { "unit": "ft",  "props": ["DataCorePlugin.GameRawData.PlaneAltAboveGround"] },

    "rpm":     { "unit": "rpm", "props": ["DataCorePlugin.GameRawData.GeneralEngRpm1", "DataCorePlugin.GameData.Rpms"] },
    "n1":      { "unit": "%",   "props": ["DataCorePlugin.GameRawData.TurbEngN1_1"] },
    "n2":      { "unit": "%",   "props": ["DataCorePlugin.GameRawData.TurbEngN2_1"] },
    "nr":      { "unit": "%",   "props": ["DataCorePlugin.GameRawData.RotorRpmPct1"] },
    "torque":  { "unit": "%",   "props": ["DataCorePlugin.GameRawData.TurbEngMaxTorquePercent1", "DataCorePlugin.GameRawData.EngTorquePercent1"] },
    "egt":     { "unit": "°C",  "props": ["DataCorePlugin.GameRawData.GeneralEngExhaustGasTemperature1", "DataCorePlugin.GameRawData.TurbEngItt1"] },
    "cht":     { "unit": "°F",  "props": ["DataCorePlugin.GameRawData.RecipEngCylinderHeadTemperature1"] },
    "oil_p":   { "unit": "psi", "props": ["DataCorePlugin.GameRawData.GeneralEngOilPressure1", "DataCorePlugin.GameData.OilPressure"] },
    "oil_t":   { "unit": "°C",  "props": ["DataCorePlugin.GameRawData.GeneralEngOilTemperature1", "DataCorePlugin.GameData.OilTemperature"] },
    "fuel":    { "unit": "%",   "props": ["DataCorePlugin.GameData.FuelPercent"] },
    "fuel_l":  { "unit": "gal", "props": ["DataCorePlugin.GameRawData.FuelLeftQuantity"] },
    "fuel_r":  { "unit": "gal", "props": ["DataCorePlugin.GameRawData.FuelRightQuantity"] },
    "fuel_flow": { "unit": "gph", "props": ["DataCorePlugin.GameRawData.EngFuelFlowGph1"] },
    "throttle":  { "unit": "%", "props": ["DataCorePlugin.GameData.Throttle"] },
    "volts":   { "unit": "V",   "props": ["DataCorePlugin.GameRawData.ElectricalMainBusVoltage"] },
    "amps":    { "unit": "A",   "props": ["DataCorePlugin.GameRawData.ElectricalGenaltBusAmps1"] },
    "suction": { "unit": "inHg","props": ["DataCorePlugin.GameRawData.SuctionPressure"] },

    "gear":    { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearHandlePosition"], "type": "number" },
    "gear_n":  { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearCenterPosition"] },
    "gear_l":  { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearLeftPosition"] },
    "gear_r":  { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearRightPosition"] },
    "flaps":   { "unit": "idx",  "props": ["DataCorePlugin.GameRawData.FlapsHandleIndex"] },
    "speedbrake": { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.SpoilersHandlePosition"] },

    "ap_master": { "type": "bool", "props": ["DataCorePlugin.GameRawData.AutopilotMaster"] },
    "ap_hdg":    { "type": "bool", "props": ["DataCorePlugin.GameRawData.AutopilotHeadingLock"] },
    "ap_nav":    { "type": "bool", "props": ["DataCorePlugin.GameRawData.AutopilotNav1Lock"] },
    "ap_alt":    { "type": "bool", "props": ["DataCorePlugin.GameRawData.AutopilotAltitudeLock"] },
    "ap_vs":     { "type": "bool", "props": ["DataCorePlugin.GameRawData.AutopilotVerticalHold"] },
    "ap_apr":    { "type": "bool", "props": ["DataCorePlugin.GameRawData.AutopilotApproachHold"] },
    "hdg_bug":   { "unit": "deg", "props": ["DataCorePlugin.GameRawData.AutopilotHeadingLockDir"] },
    "alt_sel":   { "unit": "ft",  "props": ["DataCorePlugin.GameRawData.AutopilotAltitudeLockVar"] },
    "vs_sel":    { "unit": "fpm", "props": ["DataCorePlugin.GameRawData.AutopilotVerticalHoldVar"] },
    "crs":       { "unit": "deg", "props": ["DataCorePlugin.GameRawData.Nav1Obs"] },

    "master_caution": { "type": "bool", "props": ["DataCorePlugin.GameRawData.MasterCaution"] },
    "master_warning": { "type": "bool", "props": ["DataCorePlugin.GameRawData.MasterWarning"] },
    "light_beacon":   { "type": "bool", "props": ["DataCorePlugin.GameRawData.LightBeacon"] },
    "light_landing":  { "type": "bool", "props": ["DataCorePlugin.GameRawData.LightLanding"] },
    "light_taxi":     { "type": "bool", "props": ["DataCorePlugin.GameRawData.LightTaxi"] },
    "light_nav":      { "type": "bool", "props": ["DataCorePlugin.GameRawData.LightNav"] },
    "light_strobe":   { "type": "bool", "props": ["DataCorePlugin.GameRawData.LightStrobe"] },
    "battery":        { "type": "bool", "props": ["DataCorePlugin.GameRawData.ElectricalMasterBattery"] },
    "pitot_heat":     { "type": "bool", "props": ["DataCorePlugin.GameRawData.PitotHeat"] },
    "parking_brake":  { "type": "bool", "props": ["DataCorePlugin.GameRawData.BrakeParkingPosition"] }
  },

  "dcs": {
    "_match": ["DCS"],
    "_note": "SimHub reads DCS through its own Export.lua hook (SimHub > Games > DCS World > patch). DCS gives metric/radians; conversions below assume that. Verify names in SimHub's Available properties.",

    "pitch":   { "unit": "deg", "props": ["DataCorePlugin.GameRawData.Pitch", "DataCorePlugin.GameData.OrientationPitch"], "rad2deg": false },
    "roll":    { "unit": "deg", "props": ["DataCorePlugin.GameRawData.Bank", "DataCorePlugin.GameData.OrientationRoll"] },
    "heading": { "unit": "deg", "props": ["DataCorePlugin.GameRawData.Heading", "DataCorePlugin.GameData.OrientationYaw"] },
    "ias":     { "unit": "kt",  "props": ["DataCorePlugin.GameRawData.IAS", "DataCorePlugin.GameData.SpeedKmh"], "scale": 0.539957, "_note": "IAS in km/h -> kt. If SimHub gives m/s use scale 1.94384" },
    "alt":     { "unit": "ft",  "props": ["DataCorePlugin.GameRawData.AltitudeAboveSeaLevel", "DataCorePlugin.GameRawData.Altitude"], "scale": 3.28084 },
    "radalt":  { "unit": "ft",  "props": ["DataCorePlugin.GameRawData.AltitudeAboveGroundLevel"], "scale": 3.28084 },
    "vs":      { "unit": "fpm", "props": ["DataCorePlugin.GameRawData.VerticalVelocity", "DataCorePlugin.GameRawData.VV"], "scale": 196.85, "_note": "m/s -> ft/min" },
    "turn":    { "unit": "deg", "props": ["DataCorePlugin.GameRawData.YawRate"], "rad2deg": true, "scale": 6.67 },
    "slip":    { "unit": "-1..1", "props": ["DataCorePlugin.GameRawData.SideSlip", "DataCorePlugin.GameRawData.Beta"], "rad2deg": true, "scale": 0.1 },
    "mach":    { "unit": "M",   "props": ["DataCorePlugin.GameRawData.Mach", "DataCorePlugin.GameRawData.MachNumber"] },
    "g":       { "unit": "G",   "props": ["DataCorePlugin.GameRawData.AccelerationY", "DataCorePlugin.GameRawData.G", "DataCorePlugin.GameData.AccelerationHeave"] },
    "aoa":     { "unit": "deg", "props": ["DataCorePlugin.GameRawData.AoA", "DataCorePlugin.GameRawData.AngleOfAttack"], "rad2deg": false },
    "baro":    { "unit": "hPa", "props": ["DataCorePlugin.GameRawData.BaroPressure"] },

    "rpm":     { "unit": "%",   "props": ["DataCorePlugin.GameRawData.EngineRPMLeft", "DataCorePlugin.GameData.Rpms"] },
    "n1":      { "unit": "%",   "props": ["DataCorePlugin.GameRawData.EngineRPMLeft"] },
    "n2":      { "unit": "%",   "props": ["DataCorePlugin.GameRawData.EngineRPMRight"] },
    "nr":      { "unit": "%",   "props": ["DataCorePlugin.GameRawData.RotorRPM", "DataCorePlugin.GameRawData.MainRotorRPM"] },
    "torque":  { "unit": "%",   "props": ["DataCorePlugin.GameRawData.Torque", "DataCorePlugin.GameRawData.EngineTorqueLeft"] },
    "egt":     { "unit": "°C",  "props": ["DataCorePlugin.GameRawData.EngineTempLeft"] },
    "fuel":    { "unit": "%",   "props": ["DataCorePlugin.GameData.FuelPercent"] },
    "fuel_l":  { "unit": "kg",  "props": ["DataCorePlugin.GameRawData.FuelInternal"] },
    "fuel_r":  { "unit": "kg",  "props": ["DataCorePlugin.GameRawData.FuelExternal"] },
    "throttle":{ "unit": "%",   "props": ["DataCorePlugin.GameData.Throttle"] },

    "gear":    { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearValue", "DataCorePlugin.GameRawData.Gear"] },
    "gear_n":  { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearNose"] },
    "gear_l":  { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearLeft"] },
    "gear_r":  { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.GearRight"] },
    "flaps":   { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.FlapsValue", "DataCorePlugin.GameRawData.Flaps"] },
    "speedbrake": { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.SpeedBrakeValue", "DataCorePlugin.GameRawData.AirBrake"] },
    "hook":    { "unit": "0..1", "props": ["DataCorePlugin.GameRawData.Hook"] },

    "chaff":   { "unit": "", "props": ["DataCorePlugin.GameRawData.ChaffCount", "DataCorePlugin.GameRawData.Chaff"] },
    "flare":   { "unit": "", "props": ["DataCorePlugin.GameRawData.FlareCount", "DataCorePlugin.GameRawData.Flare"] },
    "gun":     { "unit": "", "props": ["DataCorePlugin.GameRawData.GunShells", "DataCorePlugin.GameRawData.Shells"] },
    "master_caution": { "type": "bool", "props": ["DataCorePlugin.GameRawData.MasterCaution"] },
    "master_warning": { "type": "bool", "props": ["DataCorePlugin.GameRawData.MasterWarning"] }
  }
}
